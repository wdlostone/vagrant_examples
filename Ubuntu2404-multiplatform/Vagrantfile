# Kubernetes cluster (1 master + N workers) on Ubuntu 24.04 guests.
#
# Works on Linux and macOS hosts, on amd64 (Intel/AMD) and arm64 (Apple Silicon),
# with either:
#   - VirtualBox 7.1+            vagrant up --provider virtualbox
#   - VMware Workstation/Fusion  vagrant up --provider vmware_desktop
#                                (requires the vagrant-vmware-desktop plugin
#                                 and the Vagrant VMware Utility)
#
# Everything below can be tuned with environment variables, e.g.
#   WORKER_COUNT=1 NODE_MEMORY=3072 vagrant up
#   BRIDGE_IFACE=eno1 vagrant up          # Linux host, bridge the master to the LAN
# See README.md in this directory for details.

BOX            = ENV.fetch("K8S_BOX", "bento/ubuntu-24.04")
BOX_VERSION    = ENV["K8S_BOX_VERSION"]                # nil = latest
WORKER_COUNT   = ENV.fetch("WORKER_COUNT", "2").to_i
NODE_MEMORY    = ENV.fetch("NODE_MEMORY", "4096").to_i
NODE_CPUS      = ENV.fetch("NODE_CPUS", "2").to_i
NETWORK_PREFIX = ENV.fetch("NETWORK_PREFIX", "10.0.0")  # master = .10, workers = .11, .12, ...
BRIDGE_IFACE   = ENV["BRIDGE_IFACE"]                    # e.g. "eno1" (Linux) or "en0: Wi-Fi" (macOS)
K8S_VERSION    = ENV.fetch("K8S_VERSION", "1.37")       # pkgs.k8s.io minor version
CALICO_VERSION = ENV.fetch("CALICO_VERSION", "v3.33.0") # tested with Kubernetes 1.35-1.37
POD_CIDR       = ENV.fetch("POD_CIDR", "192.168.0.0/16")
INSTALL_DOCKER = ENV.fetch("INSTALL_DOCKER", "true")

MASTER_IP = "#{NETWORK_PREFIX}.10"
JOIN_FILE = File.join(__dir__, "join.sh")

Vagrant.configure("2") do |config|
  config.vm.box = BOX
  config.vm.box_version = BOX_VERSION if BOX_VERSION

  config.vm.provider :virtualbox do |v|
    v.memory = NODE_MEMORY
    v.cpus = NODE_CPUS
  end

  config.vm.provider :vmware_desktop do |v|
    v.gui = false
    v.vmx["memsize"] = NODE_MEMORY.to_s
    v.vmx["numvcpus"] = NODE_CPUS.to_s
  end

  # Common tooling on every node (container runtime + kubeadm/kubelet/kubectl)
  config.vm.provision :shell, privileged: true, path: "scripts/common.sh",
    env: {
      "K8S_VERSION"    => K8S_VERSION,
      "INSTALL_DOCKER" => INSTALL_DOCKER,
    }

  config.vm.define :master, primary: true do |master|
    master.vm.hostname = "master"
    master.vm.network "private_network", ip: MASTER_IP
    master.vm.network "public_network", bridge: BRIDGE_IFACE if BRIDGE_IFACE
    master.vm.network "forwarded_port", guest: 8080, host: 8080

    master.vm.provision :shell, privileged: false, path: "scripts/master.sh",
      env: {
        "MASTER_IP"      => MASTER_IP,
        "POD_CIDR"       => POD_CIDR,
        "NODE_CIDR"      => "#{NETWORK_PREFIX}.0/24",
        "CALICO_VERSION" => CALICO_VERSION,
      }

    # join.sh is only valid for the cluster that created it
    master.trigger.after :destroy do |t|
      t.info = "Removing stale join.sh"
      t.ruby { |_env, _machine| File.delete(JOIN_FILE) if File.exist?(JOIN_FILE) }
    end
  end

  (1..WORKER_COUNT).each do |i|
    config.vm.define "worker#{i}" do |worker|
      worker.vm.hostname = "worker#{i}"
      worker.vm.network "private_network", ip: "#{NETWORK_PREFIX}.#{10 + i}"

      worker.vm.provision :shell, privileged: true, path: "scripts/worker.sh",
        env: { "NODE_IP" => "#{NETWORK_PREFIX}.#{10 + i}" }
    end
  end
end
