{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "ignorePaths": ["Ubuntu2204/**", "Ubuntu2404/**"],
  "kubernetes": {
    "managerFilePatterns": ["/(^|/)monitoring/[^/]+\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Kubernetes minor version installed from pkgs.k8s.io",
      "managerFilePatterns": ["/(^|/)Vagrantfile$/"],
      "matchStrings": ["ENV\\.fetch\\(\"K8S_VERSION\", \"(?<currentValue>\\d+\\.\\d+)\"\\)"],
      "depNameTemplate": "kubernetes/kubernetes",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+)\\.0$",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Calico version",
      "managerFilePatterns": ["/(^|/)Vagrantfile$/"],
      "matchStrings": ["ENV\\.fetch\\(\"CALICO_VERSION\", \"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\"\\)"],
      "depNameTemplate": "projectcalico/calico",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "k8sgpt version in the README install instructions",
      "managerFilePatterns": ["/(^|/)README\\.md$/"],
      "matchStrings": ["K8SGPT_VERSION=(?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "k8sgpt-ai/k8sgpt",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Versions in the add-on scripts, marked with a `# renovate:` comment",
      "managerFilePatterns": ["/(^|/)addons/[^/]+\\.sh$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[A-Z_]+=\"\\$\\{[A-Z_]+:-(?<currentValue>[^}]+)\\}\""
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Kargo's install docs are tested with Helm 3; stay on Helm 3",
      "matchDepNames": ["helm/helm"],
      "allowedVersions": "<4"
    },
    {
      "description": "Review add-on updates together. Helm and Kargo CLI updates also need new checksums in install-kargo.sh (the Version checks workflow reports the right values)",
      "matchFileNames": ["**/addons/**"],
      "groupName": "Cluster add-ons"
    },
    {
      "description": "Review Kubernetes, Calico and metrics-server updates together; they have compatibility requirements",
      "matchDepNames": [
        "kubernetes/kubernetes",
        "projectcalico/calico",
        "registry.k8s.io/metrics-server/metrics-server"
      ],
      "groupName": "Kubernetes cluster components"
    }
  ]
}
