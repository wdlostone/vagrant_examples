// markdownlint configuration (https://github.com/DavidAnson/markdownlint)
// Purely stylistic rules are off so the check focuses on real rendering problems.
{
  "config": {
    "default": true,
    "MD009": false, // trailing spaces
    "MD012": false, // multiple blank lines
    "MD013": false, // line length
    "MD022": false, // blank lines around headings
    "MD024": { "siblings_only": true }, // duplicate headings only within the same section
    "MD026": false, // trailing punctuation in headings
    "MD031": false, // blank lines around code fences
    "MD032": false, // blank lines around lists
    "MD034": false, // bare URLs
    "MD036": false, // emphasis used as a heading
    "MD040": false, // language on code fences
    "MD041": false, // first line must be a top-level heading
    "MD059": false, // descriptive link text ("here")
    "MD060": false  // table pipe alignment
  }
}
